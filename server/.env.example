# Leave MONGODB_URI unset (or delete this file) to run in in-memory demo mode —
# zero setup, resets on restart, perfect for the hackathon demo.
#
# To persist data with real MongoDB Atlas, uncomment and fill in:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/foundational-learning

PORT=4000

# Comma-separated origins allowed to call this API. The Vite dev server default is included.
CLIENT_ORIGIN=http://localhost:5173
